# Copy this file to .env for local development.
# NEVER commit the .env file — it is in .gitignore.

# ── Application ───────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
FLEET360_DATA_DIR=src/data

# ── IBM watsonx.ai (Granite LLM) ──────────────────────────────────────────
# Get these from https://cloud.ibm.com and your watsonx.ai project settings.
# Leave blank to run in fallback (rule-based) mode — no AI calls will be made.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
