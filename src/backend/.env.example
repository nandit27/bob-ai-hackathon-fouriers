# Fleet360 Backend — environment variables
# Copy this file to .env for local development. Never commit .env.

APP_ENV=development
APP_PORT=8000

# ── IBM watsonx.ai (optional — enables Granite narration on /api/recommendations?narrate=true) ──
# Get these from https://cloud.ibm.com → watsonx.ai → Manage → API access
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Bob MCP ──
# The MCP server reads FLEET360_API_URL to locate this backend.
# Default is http://127.0.0.1:8000/api (set in mcp.json).
